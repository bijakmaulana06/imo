# Salin nilai ke environment deployment / .env.local. Semua nilai di sini placeholder.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Rahasia acak minimal 32 karakter; buat sekali dan simpan di secret manager.
# Gunakan nilai SAMA pada CLI impor dan server. Jangan ganti ketika pemilihan berjalan.
VOTING_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_FROM_YOUR_SECRET_MANAGER

# Harus origin kanonis persis; HTTPS di production, tanpa path.
APP_ORIGIN=https://imo2026.vercel.app
# Opsional: pin satu pemilihan; kosong memakai voting_elections.is_current = true.
VOTING_ELECTION_ID=

# Opsional: aktifkan HANYA bila reverse proxy menghapus/menimpa header dari klien.
# Nilai yang didukung: cf-connecting-ip, x-real-ip, x-forwarded-for.
VOTING_IP_HEADER=

# Kredensial R2 hanya di server. Batasi token ke bucket foto kandidat ini.
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=YOUR_CANDIDATE_PHOTO_BUCKET
# Custom domain publik HTTPS untuk foto kandidat saja; bukan endpoint API R2.
R2_PUBLIC_URL=https://YOUR_PUBLIC_PHOTO_DOMAIN
# proxy: aplikasi membaca foto langsung dari R2; menghindari masalah DNS r2.dev.
# direct: browser memakai R2_PUBLIC_URL (custom domain publik dianjurkan).
R2_DELIVERY_MODE=proxy
